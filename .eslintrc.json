{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "@next/next/no-img-element": "warn"
  },
  "overrides": [
    {
      "files": ["src/lib/logger.ts"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", ".next/", "out/", "coverage/", "*.config.mjs", "*.config.ts"]
}
