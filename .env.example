# ============================================================================
# OwBrand — environment configuration
# ============================================================================
# Copy to .env.local for development. Never commit a filled-in copy.
#
# The previous version of this file named variables the code does not read
# (SUPABASE_URL, AI_API_KEY, BILLING_SECRET_KEY, STORAGE_BUCKET, DATABASE_URL)
# and omitted several it does. Every entry below is read by the application;
# `grep -rn "process.env" src` is the source of truth.
#
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME. Changing one on an already
# built artifact has no effect — you must rebuild. This matters especially for
# NEXT_PUBLIC_SUPABASE_URL, which is baked into the Content-Security-Policy.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — the application will not function without these
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — it bypasses Row Level Security.
# Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin, no trailing slash. Used for OAuth redirects,
# email links and metadata. e.g. https://owbrand.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# EMAIL — Resend (transactional notifications)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY, notifications are skipped and logged as such.
# Authentication continues to work either way.
RESEND_API_KEY=
EMAIL_FROM=OwBrand <noreply@owbrand.ai>
EMAIL_REPLY_TO=

# Master switch. When false, no transactional notification is attempted.
EMAIL_NOTIFICATIONS_ENABLED=true
# Welcome email on first successful authentication.
EMAIL_NOTIFY_SIGNUP=true
# Sign-in notification. OFF by default: a mail on every login is noisy, and
# the master command warns against excessive email. When enabled it is
# de-duplicated to at most one per user per hour.
EMAIL_NOTIFY_SIGNIN=false

# ---------------------------------------------------------------------------
# BILLING — Paddle
# ---------------------------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# 'production' or anything else (treated as sandbox)
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Price IDs, created in the Paddle dashboard first.
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=

# ---------------------------------------------------------------------------
# RATE LIMITING — Upstash Redis
# ---------------------------------------------------------------------------
# Strongly recommended in production. Without it, limits are enforced
# per-process only, which does not hold across a scaled or serverless
# deployment — an attacker just needs their requests to land on different
# instances. /api/ready reports this as `degraded` in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# AI PROVIDERS
# ---------------------------------------------------------------------------
# Phase 2 introduces the provider abstraction and the Claude adapter.
# ANTHROPIC_API_KEY is read by isConfigured.ai() already so readiness reports
# honestly, but no code path uses it until Phase 2.
ANTHROPIC_API_KEY=

# Currently the only wired provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-2.0-pro

# ---------------------------------------------------------------------------
# MEDIA PROVIDERS (Phase 2)
# ---------------------------------------------------------------------------
# Provider-neutral adapters. Both URL and key must be set or the adapter
# reports itself unconfigured rather than pretending to work.
IMAGE_PROVIDER=
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_API_KEY=

VIDEO_PROVIDER=
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# SOCIAL OAUTH (Phase 3)
# ---------------------------------------------------------------------------
# Not yet read by any code path. Meta App Review for
# instagram_content_publish / pages_manage_posts takes 2-6 weeks, so start
# that process early.
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# DEPLOYMENT ADAPTERS (Phase 2)
# ---------------------------------------------------------------------------
VERCEL_API_TOKEN=
NETLIFY_API_TOKEN=

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
# Shown by /api/ready to an admin. Falls back to the Vercel commit SHA.
APP_VERSION=
